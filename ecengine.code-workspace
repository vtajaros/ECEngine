{
  "folders": [
    {
      "name": "⚡ ECEngine",
      "path": ".",
    },
  ],
  "settings": {
    "cSpell.words": [
      "GEAS",
      "ELECS"
    ],
    "editor.defaultFormatter": "esbenp.prettier-vscode",
    "editor.formatOnSave": true,
    "editor.tabSize": 2,
    "editor.fontSize": 14,
    "editor.fontFamily": "'JetBrains Mono', 'IBM Plex Mono', monospace",
    "editor.fontLigatures": true,
    "editor.lineHeight": 1.6,
    "editor.cursorBlinking": "smooth",
    "editor.bracketPairColorization.enabled": true,
    "editor.guides.bracketPairs": "active",
    "workbench.colorTheme": "One Dark Pro Night Flat",
    "workbench.iconTheme": "material-icon-theme",
    "typescript.preferences.importModuleSpecifier": "relative",
    "typescript.updateImportsOnFileMove.enabled": "always",
    "tailwindCSS.experimental.classRegex": [
      ["cn\\(([^)]*)\\)", "'([^']*)'"],
      ["clsx\\(([^)]*)\\)", "'([^']*)'"],
    ],
    "files.associations": {
      "*.css": "css",
      "*.json": "jsonc",
    },
    "emmet.includeLanguages": {
      "typescript": "html",
      "typescriptreact": "html",
    },
    "[typescript]": {
      "editor.defaultFormatter": "esbenp.prettier-vscode",
    },
    "[typescriptreact]": {
      "editor.defaultFormatter": "esbenp.prettier-vscode",
    },
    "search.exclude": {
      "**/node_modules": true,
      "**/out": true,
      "**/dist": true,
      "**/.git": true,
    },
    "explorer.fileNesting.enabled": true,
    "explorer.fileNesting.patterns": {
      "*.ts": "${capture}.js, ${capture}.d.ts",
      "tsconfig.json": "tsconfig.*.json",
      "package.json": "package-lock.json, .eslintrc*, .prettierrc*, electron-builder*, tailwind.config*",
    },
  },
  "extensions": {
    "recommendations": [
      "esbenp.prettier-vscode",
      "dbaeumer.vscode-eslint",
      "bradlc.vscode-tailwindcss",
      "ms-vscode.vscode-typescript-next",
      "zhuangtongfa.material-theme",
      "usernamehw.errorlens",
      "PKief.material-icon-theme",
      "formulahendry.auto-rename-tag",
      "naumovs.color-highlight",
      "streetsidesoftware.code-spell-checker",
      "christian-kohler.path-intellisense",
      "mikestead.dotenv",
      "kisstkondoros.vscode-gutter-preview",
      "ms-playwright.playwright",
    ],
  },
  "launch": {
    "version": "0.2.0",
    "configurations": [
      {
        "name": "🖥️ Electron Dev",
        "type": "node",
        "request": "launch",
        "runtimeExecutable": "${workspaceFolder}/node_modules/.bin/electron-vite",
        "args": ["dev"],
        "console": "integratedTerminal",
        "env": {
          "NODE_ENV": "development",
        },
      },
      {
        "name": "🌐 Web Dev",
        "type": "chrome",
        "request": "launch",
        "url": "http://localhost:5173",
        "preLaunchTask": "dev:web",
      },
    ],
  },
  "tasks": {
    "version": "2.0.0",
    "tasks": [
      {
        "label": "dev",
        "type": "shell",
        "command": "npm run dev",
        "group": "build",
        "presentation": { "reveal": "always", "panel": "new" },
      },
      {
        "label": "dev:web",
        "type": "shell",
        "command": "npm run dev:web",
        "group": "build",
        "presentation": { "reveal": "always", "panel": "new" },
      },
      {
        "label": "seed",
        "type": "shell",
        "command": "npm run seed",
        "group": "none",
      },
      {
        "label": "build",
        "type": "shell",
        "command": "npm run build",
        "group": { "kind": "build", "isDefault": true },
      },
      {
        "label": "test",
        "type": "shell",
        "command": "npm test",
        "group": { "kind": "test", "isDefault": true },
      },
    ],
  },
}
