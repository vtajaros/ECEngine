{
  "name": "ecengine",
  "productName": "ECEngine",
  "title": "ECEngine",
  "version": "0.1.0",
  "description": "ECE Board Exam Review App — Philippines",
  "main": "./out/main/index.js",
  "scripts": {
    "dev": "electron-vite dev",
    "build": "electron-vite build",
    "preview": "electron-vite preview",
    "dev:web": "vite --mode web",
    "build:web": "vite build --mode web",
    "package": "electron-builder",
    "seed": "ts-node scripts/seed-db.ts",
    "validate-content": "ts-node scripts/validate-content.ts",
    "test": "vitest run"
  },
  "dependencies": {
    "@dnd-kit/core": "^6.3.1",
    "@dnd-kit/sortable": "^10.0.0",
    "@dnd-kit/utilities": "^3.2.2",
    "@types/dompurify": "^3.0.5",
    "better-sqlite3": "^12.9.0",
    "clsx": "^2.1.1",
    "date-fns": "^3.6.0",
    "dexie": "^3.2.7",
    "dompurify": "^3.4.1",
    "framer-motion": "^11.3.0",
    "katex": "^0.16.10",
    "lucide-react": "^0.400.0",
    "pdf-parse": "^2.4.5",
    "react": "^18.3.0",
    "react-dom": "^18.3.0",
    "react-router-dom": "^6.24.0",
    "sharp": "^0.34.5",
    "sql.js": "^1.12.0",
    "tailwind-merge": "^2.4.0",
    "uuid": "^10.0.0",
    "zustand": "^4.5.0"
  },
  "devDependencies": {
    "@types/better-sqlite3": "^7.6.13",
    "@types/node": "^20.14.0",
    "@types/react": "^18.3.0",
    "@types/react-dom": "^18.3.0",
    "@types/sql.js": "^1.4.9",
    "@types/uuid": "^10.0.0",
    "@vitejs/plugin-react": "^4.3.0",
    "autoprefixer": "^10.4.19",
    "electron": "^31.0.0",
    "electron-builder": "^24.13.0",
    "electron-vite": "^2.3.0",
    "postcss": "^8.4.39",
    "prettier": "^3.3.0",
    "tailwindcss": "^3.4.0",
    "ts-node": "^10.9.0",
    "typescript": "^5.5.0",
    "vite": "^5.3.0",
    "vitest": "^2.0.0"
  },
  "build": {
    "appId": "com.ecengine.app",
    "productName": "ECEngine",
    "directories": {
      "buildResources": "resources"
    },
    "win": {
      "icon": "resources/ECEngine_orig.ico",
      "target": [
        "nsis"
      ]
    },
    "mac": {
      "icon": "resources/ECEngine_orig.icns",
      "target": [
        "dmg"
      ]
    },
    "linux": {
      "icon": "resources/ECEngine_orig.png",
      "target": [
        "AppImage"
      ]
    }
  }
}
